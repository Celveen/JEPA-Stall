__pycache__
*.pyc
figures
*outputs*
data/*
# evaluation target sets (ordered chunks of plan targets) are small and needed to run the experiments
!data/targets/
wandb
checkpoints
*.slurm
*.sh
# env/wall/data is a source package (WallDatasetConfig, layouts), not a dataset dir
!env/wall/data/
!env/wall/data/*.py

# experiment reports (write-ups, tables, json summaries, figures) are tracked; console logs and archives stay local
reports/**/*.log
reports/**/*.zip
dist
worktrees
