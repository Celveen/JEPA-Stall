__pycache__
*.pyc
figures
*outputs*
data/*
# evaluation target sets (ordered chunks of plan targets) are small and needed to run the experiments
!data/targets/
wandb
checkpoints
*.slurm
*.sh
# env/wall/data is a source package (WallDatasetConfig, layouts), not a dataset dir
!env/wall/data/
!env/wall/data/*.py

# Experiment reports and lossless .tar.gz result/log bundles are tracked; raw console logs and .zip files stay local
reports/**/*.log
reports/**/*.zip
reports/**/*.lock
!reports/**/figures/
!reports/**/*.sh
dist
worktrees
